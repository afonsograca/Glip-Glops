  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#B8B8B8"
      }
    },
    {
      "scope": [
        "comment.block.documentation",
        "comment.line.documentation",
        "comment.line.triple-slash",
        "comment.block.documentation punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#83C057"
      }
    },
    {
      "scope": [
        "comment.line.mark",
        "meta.toc-list",
        "keyword.other.mark"
      ],
      "settings": {
        "foreground": "#D4D4D4",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "keyword",
        "storage",
        "storage.type",
        "storage.modifier",
        "constant.language",
        "variable.language",
        "entity.name.tag",
        "markup.heading",
        "markup.fenced_code.block"
      ],
      "settings": {
        "foreground": "#D81196"
      }
    },
    {
      "scope": [
        "keyword.operator",
        "punctuation",
        "meta.brace",
        "variable",
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#F5F5F5"
      }
    },
    {
      "scope": [
        "string",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#DB2C38"
      }
    },
    {
      "scope": [
        "constant.character",
        "constant.character.escape",
        "string.regexp"
      ],
      "settings": {
        "foreground": "#786DC4"
      }
    },
    {
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#149C92"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "entity.name.type",
        "entity.name.class",
        "entity.name.struct",
        "entity.name.enum",
        "entity.name.namespace"
      ],
      "settings": {
        "foreground": "#F5F5F5"
      }
    },
    {
      "scope": [
        "meta.function-call entity.name.function",
        "meta.function-call.generic",
        "variable.function",
        "variable.other.property",
        "variable.other.member",
        "variable.other.constant",
        "entity.other.inherited-class",
        "meta.type.annotation entity.name.type",
        "meta.return.type entity.name.type"
      ],
      "settings": {
        "foreground": "#32CF72"
      }
    },
    {
      "scope": [
        "support",
        "support.function",
        "support.class",
        "support.type",
        "support.constant",
        "support.variable"
      ],
      "settings": {
        "foreground": "#00A0BE"
      }
    },
    {
      "scope": [
        "meta.preprocessor",
        "keyword.control.directive",
        "keyword.control.import.preprocessor",
        "punctuation.definition.directive"
      ],
      "settings": {
        "foreground": "#D97742"
      }
    },
    {
      "scope": [
        "entity.name.function.preprocessor",
        "meta.preprocessor.macro",
        "entity.name.function.macro",
        "support.function.macro"
      ],
      "settings": {
        "foreground": "#FF8C42"
      }
    },
    {
      "scope": [
        "storage.modifier.attribute",
        "storage.type.annotation",
        "meta.attribute",
        "meta.decorator",
        "punctuation.definition.annotation",
        "punctuation.decorator",
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#55747C"
      }
    },
    {
      "scope": [
        "markup.underline.link",
        "string.other.link",
        "constant.other.reference.link"
      ],
      "settings": {
        "foreground": "#485EDB",
        "fontStyle": "underline"
      }
    },
    {
      "scope": [
        "invalid",
        "invalid.illegal",
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#DB2C38"
      }
    },
    {
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#F5F5F5",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#F5F5F5",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#32CF72"
      }
    },
    {
      "scope": [
        "markup.deleted"
      ],
      "settings": {
        "foreground": "#DB2C38"
      }
    },
    {
      "scope": [
        "markup.changed"
      ],
      "settings": {
        "foreground": "#E8B339"
      }
    }
  ]
}
